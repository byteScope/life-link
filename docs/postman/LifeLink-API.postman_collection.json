						"body": {
							"mode": "raw",
							"raw": "{\n  \"doctor_id\": \"d1\",\n  \"slot\": \"2025-03-15 10:00\",\n  \"patient\": \"John Doe\",\n  \"phone\": \"+1234567890\",\n  \"care_type\": \"\",\n  \"duration\": \"30\",\n  \"location\": \"\"\n}"
						},
						"url": "{{base_lifelink}}/api/bookings",
						"description": "Legacy: create booking with doctor. Prefer POST /api/appointments with patient_id. Auth: Bearer token required."
					}
				},
				{
