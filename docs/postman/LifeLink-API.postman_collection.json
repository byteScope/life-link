		{
			"name": "Use case - Symptom to booking",
			"item": [
				{
					"name": "1. Create chat session",
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{base_chat}}/api/chat/sessions"
					}
				},
				{
					"name": "2. Send symptom",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"text\": \"Headache and mild fever for 2 days\"\n}"
						},
						"url": "{{base_chat}}/api/chat/sessions/{{chat_session_id}}/messages"
					}
				},
				{
					"name": "3. List doctors",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{base_lifelink}}/api/doctors"
					}
				},
				{
					"name": "4. Get doctor slots",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": "{{base_lifelink}}/api/doctors/d1/slots"
					}
				},
				{
					"name": "5. Create booking",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
